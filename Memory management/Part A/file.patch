diff -ruN a/sysproc.c b/sysproc.c
--- a/sysproc.c	2020-08-10 18:28:02.000000000 +0000
+++ b/sysproc.c	2026-11-14 12:18:48.891266484 +0000
@@ -51,8 +51,17 @@
   if(argint(0, &n) < 0)
     return -1;
   addr = myproc()->sz;
-  if(growproc(n) < 0)
-    return -1;
+  if(n < 0){
+    // Shrinking still frees memory right away.
+    if(growproc(n) < 0)
+      return -1;
+  } else {
+    // Lazy allocation: only grow the size. Pages are allocated and mapped
+    // on first touch by the page-fault handler in trap.c.
+    if(addr + n >= KERNBASE || addr + n < addr)
+      return -1;
+    myproc()->sz += n;
+  }
   return addr;
 }
 
diff -ruN a/trap.c b/trap.c
--- a/trap.c	2020-08-10 18:28:02.000000000 +0000
+++ b/trap.c	2026-11-14 12:18:48.893113477 +0000
@@ -14,6 +14,34 @@
 struct spinlock tickslock;
 uint ticks;
 
+int mappages(pde_t *pgdir, void *va, uint size, uint pa, int perm);
+
+// Lazy allocation: map a fresh zeroed page at the faulting address if it
+// lies inside the process's heap (below sz) and the fault was a
+// not-present fault. Returns 0 if handled, -1 if the fault is a real
+// error (bad pointer, guard page, write to read-only page, out of memory).
+static int
+handlePageFault(struct trapframe *tf)
+{
+  struct proc *p = myproc();
+  uint addr = rcr2();
+  uint va = PGROUNDDOWN(addr);
+  char *mem;
+
+  if(p == 0 || addr >= p->sz)
+    return -1;
+  if(tf->err & 1)          // bit 0 set: page was present -> protection fault
+    return -1;
+  if((mem = kalloc()) == 0)
+    return -1;
+  memset(mem, 0, PGSIZE);
+  if(mappages(p->pgdir, (char*)va, PGSIZE, V2P(mem), PTE_W|PTE_U) < 0){
+    kfree(mem);
+    return -1;
+  }
+  return 0;
+}
