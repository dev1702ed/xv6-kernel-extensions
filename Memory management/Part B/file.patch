+// Number of free physical pages (a snapshot; may change immediately).
+int
+kfreecount(void)
+{
+  int n;
+
+  if(kmem.use_lock)
+    acquire(&kmem.lock);
+  n = kmem.nfree;
+  if(kmem.use_lock)
+    release(&kmem.lock);
