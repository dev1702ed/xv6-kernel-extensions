+    panic("swap-in queue full");
+  wakeup(&queue2);                   // swapind sleeps on &queue2
+  while(!(*pte & PTE_P))
+    sleep(p, &queue2.lock);
+  release(&queue2.lock);
+  return 0;
+}
+
+// Entry point of the swap-in kernel process.
+void
+swap_in_process_function(void)
+{
+  struct proc *p;
+  pte_t *pte;
+  char *mem;
+  uint va;
+  int pid;
+
+  for(;;){
+    acquire(&queue2.lock);
