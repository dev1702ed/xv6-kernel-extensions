+// Create a thread: a new proc that shares the caller's page directory,
+// starts at fcn(arg) and runs on the one-page user stack `stack`.
+// Returns the new thread's pid, or -1.
+int
+thread_create(void (*fcn)(void*), void *arg, void *stack)
+{
+  int i, pid;
+  uint sp;
+  struct proc *np;
+  struct proc *curproc = myproc();
+
+  if((uint)stack + PGSIZE > curproc->sz)
+    return -1;
+
+  if((np = allocproc()) == 0)
+    return -1;
+
+  // Share the address space instead of copying it (cf. fork).
+  np->pgdir = curproc->pgdir;
+  np->sz = curproc->sz;
+  np->parent = curproc;
+  np->is_thread = 1;
+  *np->tf = *curproc->tf;
+
+  // Build the initial user stack: [arg][fake return PC] at the top.
+  sp = (uint)stack + PGSIZE;
+  sp -= 4;
+  *(uint*)sp = (uint)arg;
+  sp -= 4;
+  *(uint*)sp = 0xffffffff;
+  np->tf->esp = sp;
+  np->tf->eip = (uint)fcn;
+  np->tf->eax = 0;
+
+  for(i = 0; i < NOFILE; i++)
+    if(curproc->ofile[i])
+      np->ofile[i] = filedup(curproc->ofile[i]);
+  np->cwd = idup(curproc->cwd);
+
+  safestrcpy(np->name, curproc->name, sizeof(curproc->name));
+  pid = np->pid;
+
+  acquire(&ptable.lock);
+  np->state = RUNNABLE;
+  release(&ptable.lock);
+
+  return pid;
+}
+
+// Wait for a child thread (shares this address space) to exit.
+// Returns its pid, or -1 if there are none.
+int
+thread_join(void)
+{
+  return reap(1);
+}
+
+// Terminate the calling thread. exit() already does the right thing:
+// it never frees the page directory (the reaper does, on last use).
+int
+thread_exit(void)
+{
+  exit();
+  return 0;  // not reached
+}
