+int
+sys_thread_create(void)
+{
+  int fcn, arg;
+  char *stack;
+
+  if(argint(0, &fcn) < 0 || argint(1, &arg) < 0)
+    return -1;
+  // The stack must be one whole page inside the process's memory.
+  if(argptr(2, &stack, PGSIZE) < 0)
+    return -1;
+  return thread_create((void(*)(void*))fcn, (void*)arg, (void*)stack);
+}
