+
+// ---------------------------------------------------------------- Part A
+
+// Number of slots in use (embryo, sleeping, runnable, running, zombie).
+int
+getNumProc(void)
+{
+  struct proc *p;
+  int count = 0;
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+    if(p->state != UNUSED)
+      count++;
+  release(&ptable.lock);
+  return count;
+}
+
+// Largest pid among slots in use, or -1 if none.
+int
+getMaxPid(void)
+{
+  struct proc *p;
+  int max = -1;
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+    if(p->state != UNUSED && p->pid > max)
+      max = p->pid;
+  release(&ptable.lock);
+  return max;
+}
+
+// Fill *st for process pid. Returns 0, or -1 if there is no such process.
+int
+getProcInfo(int pid, struct processInfo *st)
+{
+  static char *states[] = {
+  [UNUSED]    "unused",
+  [EMBRYO]    "embryo",
+  [SLEEPING]  "sleeping",
+  [RUNNABLE]  "runnable",
+  [RUNNING]   "running",
+  [ZOMBIE]    "zombie"
+  };
+  struct proc *p;
+
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state == UNUSED || p->pid != pid)
+      continue;
+    st->ppid = p->parent ? p->parent->pid : 0;
+    st->psize = p->sz;
+    st->numberContextSwitches = p->contextswitches;
+    st->burst_time = p->burst_time;
+    st->killed = p->killed;
+    safestrcpy(st->name, p->name, sizeof(st->name));
+    safestrcpy(st->state, states[p->state], sizeof(st->state));
+    release(&ptable.lock);
+    return 0;
+  }
+  release(&ptable.lock);
+  return -1;
+}
+
+// Set the calling process's expected burst (timer ticks, > 0).
+// Yields once so that a parent forking several children gets to
+// fork them all, and each child gets to set its burst, before the
+// scheduler starts choosing between them.
+int
+set_burst_time(int n)
+{
+  struct proc *p = myproc();
+
+  if(n <= 0)
+    return -1;
+  acquire(&ptable.lock);
+  p->burst_time = n;
+  p->remaining = n;
+  release(&ptable.lock);
+  yield();
+  return 0;
+}
+
+int
+get_burst_time(void)
+{
+  int n;
+
+  acquire(&ptable.lock);
+  n = myproc()->burst_time;
+  release(&ptable.lock);
+  return n;
+}
