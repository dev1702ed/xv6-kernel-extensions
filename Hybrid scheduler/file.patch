+// ---------------------------------------------------------------- min-heap
+// Ordering key. SJF: total expected burst. Hybrid: burst still remaining.
+// Processes that never set a burst (init, sh, test parents) have key 0
+// and are therefore always picked first.
+static int
+key(struct proc *p)
+{
+#ifdef SCHED_HYBRID
+  return p->remaining;
+#else
+  return p->burst_time;
+#endif
+}
+
+static void
+heap_swap(MinHeap *h, int i, int j)
+{
+  struct proc *t = h->arr[i];
+  h->arr[i] = h->arr[j];
+  h->arr[j] = t;
+}
+
+// O(log n)
+static void __attribute__((unused))
+heap_push(MinHeap *h, struct proc *p)
+{
+  int i;
+
+  if(h->size == NPROC)
+    panic("heap_push: full");
+  i = h->size++;
+  h->arr[i] = p;
+  while(i > 0 && key(h->arr[(i-1)/2]) > key(h->arr[i])){
+    heap_swap(h, i, (i-1)/2);
+    i = (i-1)/2;
+  }
+}
+
+// Remove and return the process with the smallest key. O(log n)
+static __attribute__((unused)) struct proc*
+heap_pop(MinHeap *h)
+{
+  struct proc *top;
+  int i, l, r, m;
+
+  if(h->size == 0)
+    return 0;
+  top = h->arr[0];
+  h->arr[0] = h->arr[--h->size];
+  i = 0;
+  for(;;){
+    l = 2*i + 1; r = 2*i + 2; m = i;
+    if(l < h->size && key(h->arr[l]) < key(h->arr[m])) m = l;
+    if(r < h->size && key(h->arr[r]) < key(h->arr[m])) m = r;
+    if(m == i)
+      break;
+    heap_swap(h, i, m);
+    i = m;
+  }
+  return top;
+}
+
+// Mark p RUNNABLE and put it in the current round's ready queue.
+// Every transition to RUNNABLE goes through here (or through yield()).
+// Caller must hold ptable.lock.
+static void
+make_runnable(struct proc *p)
+{
+  p->state = RUNNABLE;
+#ifndef SCHED_RR
+  heap_push(&rq.ready, p);
+#endif
+}
+
+#ifdef SCHED_HYBRID
+// Start a new round: everything that used up its slice becomes eligible
+// again, and the slice is the smallest remaining burst among them
+// (the paper's "burst time of the first process in RQ"). O(n)
+static void
+new_round(void)
+{
+  int i, q = 0;
+
+  rq.ready = rq.next;
+  rq.next.size = 0;
+  for(i = 0; i < rq.ready.size; i++){
+    int k = rq.ready.arr[i]->remaining;
+    if(k > 0 && (q == 0 || k < q))
+      q = k;
+  }
+  rq.quantum = q > 0 ? q : 1;
+}
+#endif
+
+// Called from trap() on every timer tick for the running process.
+// Returns 1 if the process should be preempted.
+int
+sched_tick(struct proc *p)
+{
+  p->time_elapsed++;
+  if(p->remaining > 0)
+    p->remaining--;
+#if defined(SCHED_RR)
+  return 1;                        // round robin: preempt every tick
+#elif defined(SCHED_SJF)
+  return 0;                        // non-preemptive shortest job first
+#else
+  return p->time_elapsed >= rq.quantum;   // hybrid: one slice per round
+#endif
 }
 
